generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


// Enums

enum UserType {
  Monk
  Donor
}

model User {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  username     String
  email        String?  @unique
  password     String
  userType     UserType @map("user_type")
  fcmToken     String?  @map("fcm_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  refreshToken RefreshToken[]
  @@map("users")
}

model Donor {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phoneNo   String   @map("phone_no")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt  @map("updated_at")

  user         User?
  donationList DonationList[]

  @@unique([id, name])
  @@index([name, email])
  @@index([phoneNo])
  @@index([email])
  @@map("donors")

}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  refreshToken String    @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DonationList {
  id              Int            @id @default(autoincrement())
  status          DonationStatus @default(Pending)
  donationDueDate DateTime       @map("donation_due_date")
  createdDate     DateTime       @map("created_date")
  updatedDate     DateTime?      @map("update_at")

  monasteryId    Int            @map("monastery_id")
  monastery      Monastery      @relation(fields: [monasteryId], references: [id])
  donorName      String         @unique @map("donor_name")
  donorId        Int            @map("donor_id")
  donor          Donor          @relation(fields: [donorId, donorName], references: [id, name])
  reviewerId     Int?           @map("reviewer_id")
  reviewer       monasteryMember? @relation(fields: [reviewerId], references: [id])
  donationTypeId Int            @map("donation_type_id")
  donationType   DonationType   @relation(fields: [donationTypeId], references: [id])

  @@index([donorId])
  @@index([donationTypeId])
  @@index([monasteryId])
  @@index([reviewerId])
  @@index([donorId, donationDueDate])
  @@index([status])
  @@map("donation_lists")
}

model DonationType {
  id           Int              @id @default(autoincrement())
  donationType DonationTypeName @map("donation_type")
  duration     Int    
  createdAt    DateTime         @default(now())  @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  donationList DonationList[]

  @@index([donationType])
  @@map("donation_types")

}

  model RefreshToken {
  id            Int       @id @default (autoincrement())
  userId        Int       @map("user_id")
  refreshToken  String    @unique @map("refresh_token")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime?  @map("revoked_at")
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([refreshToken, revokedAt])
  @@map("refresh_tokens")
}